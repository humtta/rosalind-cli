{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",

  "shell": {
    "init_hook": ["go mod tidy"],

    "scripts": {
      "format": "go fmt ./...",
      "lint": "go vet ./...",
      "check": "devbox run format && devbox run lint",

      "dev": "go run ./cmd/rosalind/",
      "build": "go build -o ./out/rosalind ./cmd/rosalind/"
    }
  },

  "packages": {
    "go": "1.26.3",
    "go-task": "3.48.0"
  }
}
